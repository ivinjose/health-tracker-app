# API base URL for health-tracker backend
# - iOS Simulator / Expo Web: http://localhost:4000
# - Android Emulator: http://10.0.2.2:4000 (default when unset)
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Show the optional PDF/image upload field on add report. Set false to hide it.
EXPO_PUBLIC_REPORT_UPLOAD=true
