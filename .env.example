# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Restart Metro after changing this file.

# Origin of health-tracker-server. No trailing slash, no `/api`.
# Simulator / web: http://localhost:4000
# Expo Go on a phone: http://<Mac LAN IP>:4000  (localhost is the phone, not your Mac)
# Production: https://www.healthtracker.com
EXPO_PUBLIC_API_HOST=http://localhost:4000
